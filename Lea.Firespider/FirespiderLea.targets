<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="Accessibility" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <Reference Include="Lea.Engine">
      <HintPath>$(MSBuildThisFileDirectory)Lea.Engine.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Lea.Win">
      <HintPath>$(MSBuildThisFileDirectory)Lea.Win.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Compile Include="$(MSBuildThisFileDirectory)..\FirespiderLea.vb" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FirespiderSplit.vb" />
    <Content Include="$(MSBuildThisFileDirectory)start.html">
      <Link>Lea\start.html</Link>
      <TargetPath>Lea\start.html</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyLeaImageWorker" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Lea.Image.exe"
          DestinationFiles="$(TargetDir)Lea.Image.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
