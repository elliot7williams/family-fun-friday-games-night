<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <W32 Condition="'$(W32)' == ''">0</W32>
    <Be Condition="'$(Be)' == ''">0</Be>
    <DefineConstants Condition="'$(Be)' == '1'">$(DefineConstants);LEA_INDIRECT_BOOTSTRAP</DefineConstants>
    <DefineConstants Condition="'$(Be)' == '2'">$(DefineConstants);LEA_PREPARED_BOOTSTRAP</DefineConstants>
    <PlatformTarget Condition="'$(W32)' == '1' And '$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit Condition="'$(W32)' == '1'">true</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.4" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="..\Lea.Script\Wire.cs" Link="Wire.cs" />
    <Compile Include="..\Lea.Script\Codec.cs" Link="Codec.cs" />
    <Compile Include="..\Lea.Script\Vo.cs" Link="Vo.cs" />
    <Compile Include="..\Lea.Image\Mg.cs" Link="Mg.cs" />
    <EmbeddedResource Include="..\Lea.Script\Dom.compact.js" Link="Dom.js" LogicalName="Lea.Script.Dom.js" />
  </ItemGroup>
  <Import Project="..\Lea.Script\Dom.targets" />
  <Target Name="ValidateLeaBootstrapEntry" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Be)' != '0' And '$(Be)' != '1' And '$(Be)' != '2'"
           Text="Be must be 0 (normal), 1 (indirect) or 2 (prepared bootstrap)." />
    <Error Condition="'$(Be)' != '1' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])LEA_INDIRECT_BOOTSTRAP($|[;,\s])'))"
           Text="LEA_INDIRECT_BOOTSTRAP requires Be=1; do not override the bootstrap symbol directly." />
    <Error Condition="'$(Be)' != '2' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])LEA_PREPARED_BOOTSTRAP($|[;,\s])'))"
           Text="LEA_PREPARED_BOOTSTRAP requires Be=2; do not override the bootstrap symbol directly." />
    <Error Condition="'$(Be)' == '1' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])LEA_INDIRECT_BOOTSTRAP($|[;,\s])'))"
           Text="Be=1 requires LEA_INDIRECT_BOOTSTRAP; do not replace DefineConstants globally." />
    <Error Condition="'$(Be)' == '2' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])LEA_PREPARED_BOOTSTRAP($|[;,\s])'))"
           Text="Be=2 requires LEA_PREPARED_BOOTSTRAP; do not replace DefineConstants globally." />
  </Target>
  <Target Name="ValidateLeaWorkerBitness" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(W32)' != '0' And '$(W32)' != '1'"
           Text="W32 must be 0 (normal) or 1 (experimental 32-bit preference)." />
    <Error Condition="'$(W32)' == '1' And ('$(PlatformTarget)' != 'AnyCPU' Or '$(Prefer32Bit)' != 'true')"
           Text="W32=1 requires AnyCPU and Prefer32Bit=true; remove conflicting platform or preference overrides." />
  </Target>
</Project>
