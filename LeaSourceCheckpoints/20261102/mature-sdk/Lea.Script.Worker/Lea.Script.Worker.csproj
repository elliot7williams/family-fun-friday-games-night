<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishReadyToRun>false</PublishReadyToRun>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>12.0</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Optimize>true</Optimize>
    <OutputPath>..\worker-il\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Jint">
      <HintPath>..\lib\worker\Jint.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Acornima">
      <HintPath>..\lib\worker\Acornima.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="Mg.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="NetworkProbe.cs" />
    <Compile Include="Bm.cs" />
    <Compile Include="Codec.cs" />
    <Compile Include="Vo.cs" />
    <Compile Include="Dc.cs" />
    <Compile Include="Wire.Modern.cs" />
    <Compile Include="Json8.cs" />
    <Compile Include="ReferenceSupport.cs" />
    <Compile Include="JavaScriptObjectDeserializer.cs" />
    <Compile Include="JavaScriptString.cs" />
    <Compile Include="Utf16StringValidator.cs" />
    <Compile Include="Resources.cs" />
    <Compile Include="Writer.cs" />
    <Compile Include="WriterResources.cs" />
    <Compile Include="Modern.AssemblyInfo.cs" />
    <EmbeddedResource Include="Dom.compact.js">
      <LogicalName>Lea.Script.Dom.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>