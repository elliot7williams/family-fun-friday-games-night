<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(LeaScriptEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants),LEA_SCRIPT=True</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Accessibility" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <Reference Include="Lea.Engine">
      <HintPath>$(MSBuildThisFileDirectory)Lea.Engine.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Lea.Win">
      <HintPath>$(MSBuildThisFileDirectory)Lea.Win.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Compile Include="$(MSBuildThisFileDirectory)..\FirespiderLea.vb" />
    <Compile Include="$(MSBuildThisFileDirectory)..\FirespiderSplit.vb" />
    <Content Include="$(MSBuildThisFileDirectory)start.html">
      <Link>Lea\start.html</Link>
      <TargetPath>Lea\start.html</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(LeaScriptEnabled)' == 'true'">
    <Reference Include="Lea.Script.Win">
      <HintPath>$(MSBuildThisFileDirectory)Lea.Script.Win.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <LeaScriptFiles Include="$(MSBuildThisFileDirectory)Lea.Script.dll;$(MSBuildThisFileDirectory)Jint.dll;$(MSBuildThisFileDirectory)Acornima.dll;$(MSBuildThisFileDirectory)System.Memory.dll;$(MSBuildThisFileDirectory)System.Buffers.dll;$(MSBuildThisFileDirectory)System.Numerics.Vectors.dll;$(MSBuildThisFileDirectory)System.Runtime.CompilerServices.Unsafe.dll" />
    <LeaScriptWorker Include="$(MSBuildThisFileDirectory)ScriptWorker\*" />
  </ItemGroup>
  <Target Name="CheckLeaScriptFramework" BeforeTargets="ResolveReferences" Condition="'$(LeaScriptEnabled)' == 'true'">
    <Error Condition="'$(TargetFrameworkVersion)' != 'v4.6.2' And '$(TargetFrameworkVersion)' != 'v4.7' And '$(TargetFrameworkVersion)' != 'v4.7.1' And '$(TargetFrameworkVersion)' != 'v4.7.2' And '$(TargetFrameworkVersion)' != 'v4.8' And '$(TargetFrameworkVersion)' != 'v4.8.1'"
           Text="Optional Lea scripting requires .NET Framework 4.6.2 or later. Rebuild a separate migrated host candidate first." />
  </Target>
  <Target Name="CheckLeaRuntime" BeforeTargets="ResolveReferences;CopyLeaImageWorker;CopyLeaScriptRuntime">
    <ItemGroup>
      <LeaRequiredRuntime Include="$(MSBuildThisFileDirectory)Lea.Engine.dll;$(MSBuildThisFileDirectory)Lea.Win.dll;$(MSBuildThisFileDirectory)Lea.Image.exe" />
      <LeaRequiredRuntime Include="$(MSBuildThisFileDirectory)Lea.Script.Win.dll;@(LeaScriptFiles)" Condition="'$(LeaScriptEnabled)' == 'true'" />
      <LeaRequiredRuntime Include="$(MSBuildThisFileDirectory)ScriptWorker\Jint.dll;$(MSBuildThisFileDirectory)ScriptWorker\Acornima.dll" Condition="'$(LeaScriptEnabled)' == 'true'" />
      <LeaRequiredRuntime Include="$(MSBuildThisFileDirectory)ScriptWorker\Lea.Script.Worker.deps.json;$(MSBuildThisFileDirectory)ScriptWorker\Lea.Script.Worker.runtimeconfig.json" Condition="'$(LeaScriptEnabled)' == 'true' And Exists('$(MSBuildThisFileDirectory)ScriptWorker\Lea.Script.Worker.dll')" />
    </ItemGroup>
    <Error Condition="!Exists('%(LeaRequiredRuntime.Identity)')" Text="Incomplete Lea runtime: missing %(LeaRequiredRuntime.Identity). Use a complete matching engine package." />
    <Error Condition="'$(LeaScriptEnabled)' == 'true' And !Exists('$(MSBuildThisFileDirectory)ScriptWorker\Lea.Script.Worker.exe') And !Exists('$(MSBuildThisFileDirectory)ScriptWorker\Lea.Script.Worker.dll')" Text="Incomplete Lea runtime: ScriptWorker requires Lea.Script.Worker.exe or Lea.Script.Worker.dll and its matching dependencies." />
  </Target>
  <Target Name="CopyLeaImageWorker" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Lea.Image.exe"
          DestinationFiles="$(TargetDir)Lea.Image.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyLeaScriptRuntime" AfterTargets="Build" Condition="'$(LeaScriptEnabled)' == 'true'">
    <Copy SourceFiles="@(LeaScriptFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LeaScriptWorker)" DestinationFolder="$(TargetDir)ScriptWorker" SkipUnchangedFiles="true" />
  </Target>
</Project>
