<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <LeaSdkBin Condition="'$(LeaSdkBin)' == ''">..\bin\Release</LeaSdkBin>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Lea.EmbeddingSample</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>12.0</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Lea.Engine"><HintPath>$(LeaSdkBin)\Lea.Engine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lea.Win"><HintPath>$(LeaSdkBin)\Lea.Win.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="EmbeddingSample.cs" />
    <Content Include="embedding.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
