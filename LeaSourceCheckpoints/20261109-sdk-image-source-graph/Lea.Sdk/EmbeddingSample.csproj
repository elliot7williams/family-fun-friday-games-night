<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <LeaBuildFromSource Condition="'$(LeaBuildFromSource)' == '' And '$(LeaSdkBin)' == '' And Exists('..\Lea.Engine\Lea.Engine.csproj') And Exists('..\Lea.Win\Lea.Win.csproj')">true</LeaBuildFromSource>
    <LeaSdkBin Condition="'$(LeaSdkBin)' == ''">..\bin\$(Configuration)</LeaSdkBin>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Lea.EmbeddingSample</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>12.0</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Lea.Engine" Condition="'$(LeaBuildFromSource)' != 'true'"><HintPath>$(LeaSdkBin)\Lea.Engine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lea.Win" Condition="'$(LeaBuildFromSource)' != 'true'"><HintPath>$(LeaSdkBin)\Lea.Win.dll</HintPath><Private>true</Private></Reference>
    <ProjectReference Include="..\Lea.Engine\Lea.Engine.csproj" Condition="'$(LeaBuildFromSource)' == 'true'"><Name>Lea.Engine</Name></ProjectReference>
    <ProjectReference Include="..\Lea.Win\Lea.Win.csproj" Condition="'$(LeaBuildFromSource)' == 'true'"><Name>Lea.Win</Name></ProjectReference>
    <ProjectReference Include="..\Lea.Image\Lea.Image.csproj" Condition="'$(LeaBuildFromSource)' == 'true' And Exists('..\Lea.Image\Lea.Image.csproj')">
      <Name>Lea.Image</Name><ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Compile Include="EmbeddingSample.cs" />
    <Content Include="embedding.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\bin\$(Configuration)\Lea.Image.exe" Condition="'$(LeaBuildFromSource)' == 'true' And Exists('..\Lea.Image\Lea.Image.csproj')">
      <Link>Lea.Image.exe</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(LeaSdkBin)\Lea.Image.exe" Condition="'$(LeaBuildFromSource)' != 'true' And Exists('$(LeaSdkBin)\Lea.Image.exe')">
      <Link>Lea.Image.exe</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
