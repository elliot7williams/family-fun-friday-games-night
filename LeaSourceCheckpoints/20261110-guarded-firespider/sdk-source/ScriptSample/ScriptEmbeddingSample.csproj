<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <LeaSdkBin Condition="'$(LeaSdkBin)' == ''">..\bin\Release</LeaSdkBin>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Lea.ScriptEmbeddingSample</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>12.0</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppConfig>ScriptHost.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="Lea.Engine"><HintPath>$(LeaSdkBin)\Lea.Engine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lea.Win"><HintPath>$(LeaSdkBin)\Lea.Win.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lea.Script"><HintPath>$(LeaSdkBin)\Lea.Script.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lea.Script.Win"><HintPath>$(LeaSdkBin)\Lea.Script.Win.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="ScriptEmbeddingSample.cs" />
    <Content Include="script-embedding.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(LeaSdkBin)\*.dll"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(LeaSdkBin)\ScriptWorker\*"><Link>ScriptWorker\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
